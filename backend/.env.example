# Zenvora backend configuration.
# Copy this file to backend/.env and adjust values as needed.

ZENVORA_ENVIRONMENT=development
ZENVORA_DEBUG=false
ZENVORA_API_V1_PREFIX=/api/v1

# Defaults to backend/data/zenvora.db. Relative paths resolve from the
# directory the backend is started in.
# ZENVORA_DATABASE_URL=sqlite:///./data/zenvora.db

ZENVORA_CORS_ORIGINS=["http://localhost:3000"]

# JWT authentication. Use a long random secret outside local development.
ZENVORA_JWT_SECRET_KEY=dev-only-change-me-use-a-long-random-secret
ZENVORA_JWT_ALGORITHM=HS256
ZENVORA_ACCESS_TOKEN_EXPIRE_MINUTES=60
